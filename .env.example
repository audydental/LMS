# ============================================================
# AUDY LEARNING CENTRE — Environment Variables
# Copy this file to .env.local for local development.
# Never commit .env or .env.local to version control.
# ============================================================

# ── Supabase (Public — safe for browser) ────────────────────
# Found in: Supabase Dashboard → Project Settings → API
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key-here

# ── Server-only (NEVER expose to browser) ───────────────────
# Only needed for admin server-side operations.
# Never import from $env/static/public — use $env/static/private.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Application ──────────────────────────────────────────────
# The public URL of the application (used for auth redirects)
# PUBLIC_APP_URL=http://localhost:5173
